+    // Locks integration: occupy the tracker's writer slot once, exactly as a
+    // public writer would (waiting on the unchanged Condvar), and hand
+    // transaction-ID allocation to the delegated path. Returns false if
+    // delegated mode is already active (a second gate would wait forever).
+    pub(crate) fn enter_delegated_mode(&self) -> bool {
+        let mut state = self.state.lock().unwrap();
+        if state.live_write_transaction == Some(DELEGATED_MODE_SLOT) {
+            return false;
+        }
+        while state.live_write_transaction.is_some() {
+            state = self.live_write_transaction_available.wait(state).unwrap();
+        }
+        assert!(!self.delegated_mode.load(AtomicOrdering::Acquire));
+        state.live_write_transaction = Some(DELEGATED_MODE_SLOT);
+        self.delegated_last_transaction_id
+            .store(state.next_transaction_id.raw_id(), AtomicOrdering::Relaxed);
+        self.delegated_live_write_transaction
+            .store(NO_DELEGATED_WRITER, AtomicOrdering::Relaxed);
+        self.delegated_mode.store(true, AtomicOrdering::Release);
+        true
+    }
+
+    // Locks integration: return ID allocation to the tracker and release its
+    // writer slot. Requires every delegated writer to have ended.
+    pub(crate) fn exit_delegated_mode(&self) {
+        let mut state = self.state.lock().unwrap();
+        assert_eq!(state.live_write_transaction, Some(DELEGATED_MODE_SLOT));
+        assert_eq!(
+            self.delegated_live_write_transaction
+                .load(AtomicOrdering::Acquire),
+            NO_DELEGATED_WRITER,
+            "delegated writer still live when leaving delegated mode"
+        );
+        assert!(self.delegated_mode.swap(false, AtomicOrdering::AcqRel));
+        let last = TransactionId(
+            self.delegated_last_transaction_id
+                .load(AtomicOrdering::Relaxed),
+        );
+        assert!(last >= state.next_transaction_id);
+        state.next_transaction_id = last;
+        state.live_write_transaction = None;
+        self.live_write_transaction_available.notify_one();
+    }
+
+    // Locks integration: delegated counterpart of start_write_transaction.
