 using namespace upscaledb;
 
+// Profile build only. The hold timestamp is taken immediately BEFORE the
+// ScopedLock destructor unlocks; it includes neither unlock nor its overhead.
+// Each original caller reads its own TLS after the public API has returned.
+namespace {
+struct NativeLockSample {
+  uint64_t wait_ns;
+  uint64_t hold_pre_release_ns;
+  uint32_t operation; // 1=find, 2=insert
+};
+thread_local NativeLockSample last_native_lock_sample = {0, 0, 0};
+
+static uint64_t native_lock_clock_ns() {
+  using namespace std::chrono;
+  return duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+struct NativeLockHold {
+  NativeLockHold(uint64_t attempted, uint32_t op)
+    : acquired(op ? native_lock_clock_ns() : 0), operation(op) {
+    last_native_lock_sample.operation = 0;
+    if (op) last_native_lock_sample.wait_ns = acquired - attempted;
+  }
+  ~NativeLockHold() {
+    if (operation) {
+      last_native_lock_sample.hold_pre_release_ns = native_lock_clock_ns() - acquired;
+      last_native_lock_sample.operation = operation;
+    }
+  }
+  uint64_t acquired;
+  uint32_t operation;
+};
+} // namespace
+
+extern "C" {
+UPS_EXPORT void UPS_CALLCONV
+ups_native_lock_sample(uint64_t *wait_ns, uint64_t *hold_pre_release_ns,
+                       uint32_t *operation) {
+  *wait_ns = last_native_lock_sample.wait_ns;
+  *hold_pre_release_ns = last_native_lock_sample.hold_pre_release_ns;
+  *operation = last_native_lock_sample.operation;
+  last_native_lock_sample.operation = 0;
+}
+}
