   return db ? db->env->mutex.native_handle() : 0;
 }
 
+namespace {
+// A batch is one nontransactional scheduling unit, not one transaction. Once
+// submitted, all eight real insert bodies run under the same acquired gate.
+// If an insert fails, preceding inserts remain committed in the in-memory DB.
+struct BatchCall {
+  Db *db;
+  ups_key_t *keys;
+  ups_record_t *records;
+  ups_status_t *statuses;
+  ups_status_t result;
+};
+
+void batch_body(BatchCall *call) noexcept {
+  for (unsigned n = 0; n < 8; ++n) {
+    try {
+      call->statuses[n] = dlock_insert_body(call->db, 0,
+                                            &call->keys[n], &call->records[n], 0);
+    } catch (Exception &ex) { call->statuses[n] = ex.code; }
+    catch (...) { std::terminate(); }
+    if (call->statuses[n]) {
+      call->result = call->statuses[n];
+      return;
+    }
+  }
+  call->result = UPS_SUCCESS;
+}
+
+void batch_invoke(void *raw) noexcept { batch_body(static_cast<BatchCall *>(raw)); }
+
+bool batch_inputs(ups_db_t *hdb, ups_key_t *keys, ups_record_t *records,
+                  ups_status_t *statuses) {
+  if (!hdb || !keys || !records || !statuses) return false;
+  Db *db = (Db *)hdb;
+  if (db->config.flags != UPS_FORCE_RECORDS_INLINE ||
+      db->config.key_type != UPS_TYPE_UINT64 || db->config.key_size != 8 ||
+      db->config.record_size != 8 ||
+      db->env->config.flags != (UPS_IN_MEMORY | UPS_DISABLE_RECLAIM_INTERNAL))
+    return false;
+  for (unsigned n = 0; n < 8; ++n) {
+    if (!keys[n].data || !records[n].data || keys[n].flags || records[n].flags ||
+        !prepare_key(&keys[n]) || !prepare_record(&records[n])) return false;
+  }
+  return true;
+}
+
+void sample_native(dlock_request_metrics *metrics,
+                   std::chrono::steady_clock::time_point start) {
+  if (metrics) {
+    metrics->service_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    metrics->service_tsc_ticks = 0; // no native TSC sampling
+    metrics->enabled = 1;
+    metrics->reserved = 0;
+  }
+}
+} // namespace
+
+extern "C" ups_status_t
+ups_dlock_private_batch(ups_db_t *hdb, ups_key_t *keys,
+                        ups_record_t *records, ups_status_t *statuses,
+                        dlock_bridge *gate, ups_dlock_submit submit,
+                        dlock_request_metrics *metrics, int32_t *bridge_status)
+{
+  if (bridge_status) *bridge_status = DLOCK_BRIDGE_INVALID;
+  if (!gate || !submit || !bridge_status ||
+      !batch_inputs(hdb, keys, records, statuses)) return UPS_INV_PARAMETER;
+  for (unsigned n = 0; n < 8; ++n) statuses[n] = UPS_INTERNAL_ERROR;
+  BatchCall call = {(Db *)hdb, keys, records, statuses, UPS_INTERNAL_ERROR};
+  *bridge_status = submit(gate, batch_invoke, &call, metrics);
+  return *bridge_status == DLOCK_BRIDGE_OK ? call.result : UPS_INTERNAL_ERROR;
+}
+
+extern "C" ups_status_t
+ups_dlock_private_native_batch(ups_db_t *hdb, ups_key_t *keys,
+                               ups_record_t *records, ups_status_t *statuses,
+                               dlock_request_metrics *metrics)
+{
+  if (!batch_inputs(hdb, keys, records, statuses)) return UPS_INV_PARAMETER;
+  for (unsigned n = 0; n < 8; ++n) statuses[n] = UPS_INTERNAL_ERROR;
+  BatchCall call = {(Db *)hdb, keys, records, statuses, UPS_INTERNAL_ERROR};
+  try {
+    ScopedLock lock(call.db->env->mutex);
+    const auto start = metrics ? std::chrono::steady_clock::now()
+                               : std::chrono::steady_clock::time_point{};
+    batch_body(&call);
+    sample_native(metrics, start); // pre-unlock serialized opportunity time
+  } catch (Exception &ex) { return ex.code; }
+  catch (...) { std::terminate(); }
+  return call.result;
+}
+
+extern "C" ups_status_t
+ups_dlock_private_native_find(ups_db_t *hdb, ups_key_t *key,
+                              ups_record_t *record, dlock_request_metrics *metrics)
+{
+  if (!hdb || !key || !record || !key->data || !record->data ||
+      key->flags != UPS_KEY_USER_ALLOC || record->flags != UPS_RECORD_USER_ALLOC ||
+      !prepare_key(key) || !prepare_record(record)) return UPS_INV_PARAMETER;
+  Db *db = (Db *)hdb;
+  try {
+    ScopedLock lock(db->env->mutex);
+    const auto start = std::chrono::steady_clock::now();
+    ups_status_t status = dlock_find_body(db, 0, key, record, 0);
+    sample_native(metrics, start);
+    return status;
+  } catch (Exception &ex) { return ex.code; }
+  catch (...) { std::terminate(); }
+}
+extern "C" ups_status_t
+ups_dlock_private_native_insert(ups_db_t *hdb, ups_key_t *key,
+                                ups_record_t *record, dlock_request_metrics *metrics)
+{
+  if (!hdb || !key || !record || !key->data || !record->data ||
+      key->flags || record->flags || !prepare_key(key) || !prepare_record(record))
+    return UPS_INV_PARAMETER;
+  Db *db = (Db *)hdb;
+  try {
+    ScopedLock lock(db->env->mutex);
+    const auto start = std::chrono::steady_clock::now();
+    ups_status_t status = dlock_insert_body(db, 0, key, record, 0);
+    sample_native(metrics, start);
+    return status;
+  } catch (Exception &ex) { return ex.code; }
+  catch (...) { std::terminate(); }
+}
+
 #ifdef DLOCK_BRIDGE_TEST_HOOKS
 extern "C" int32_t ups_dlock_private_test_throw(dlock_bridge *gate,
                                                  ups_dlock_submit submit) {
