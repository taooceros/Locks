+namespace {
+#ifdef DLOCK_BRIDGE_TEST_HOOKS
+std::atomic<int> dlock_test_pause(0), dlock_test_entered(0);
+#endif
+struct DlockCall {
+  Db *db;
+  ups_key_t *key;
+  ups_record_t *record;
+  bool insert;
+  ups_status_t result;
+#ifdef DLOCK_BRIDGE_TEST_HOOKS
+  bool expected_exception;
+#endif
+};
+
+// The actual callback used in every bridge mode. Never let a C++ exception
+// cross the C/Rust ABI, including one arising during stack-local cleanup.
+void dlock_invoke(void *opaque) noexcept {
+  DlockCall *call = static_cast<DlockCall *>(opaque);
+  try {
+#ifdef DLOCK_BRIDGE_TEST_HOOKS
+    if (call->expected_exception)
+      throw Exception(UPS_KEY_NOT_FOUND);
+    if (!call->db)
+      throw std::runtime_error("injected unexpected C++ callback exception");
+    if (dlock_test_pause.load(std::memory_order_acquire)) {
+      dlock_test_entered.store(1, std::memory_order_release);
+      while (dlock_test_pause.load(std::memory_order_acquire))
+        std::this_thread::yield();
+    }
+#endif
+    call->result = call->insert
+        ? dlock_insert_body(call->db, 0, call->key, call->record, 0)
+        : dlock_find_body(call->db, 0, call->key, call->record, 0);
+  }
+  catch (Exception &ex) { call->result = ex.code; }
+  catch (...) { std::terminate(); }
+}
+
+ups_status_t dlock_dispatch(ups_db_t *hdb, ups_key_t *key,
+                            ups_record_t *record, bool insert,
+                            dlock_bridge *gate, ups_dlock_submit submit,
+                            dlock_request_metrics *metrics, int32_t *bridge_status)
+{
+  // The bridge is the sole active gate: never enter the public locking API.
+  // Restrict to fixed-width user-owned output and the approved DB schema.
+  if (!bridge_status || !gate || !submit || !hdb || !key || !record) {
+    if (bridge_status) *bridge_status = DLOCK_BRIDGE_INVALID;
+    return UPS_INV_PARAMETER;
+  }
+  *bridge_status = DLOCK_BRIDGE_INVALID;
+  if (!key->data || !record->data ||
+      (insert ? key->flags != 0 || record->flags != 0
+              : key->flags != UPS_KEY_USER_ALLOC ||
+                record->flags != UPS_RECORD_USER_ALLOC))
+    return UPS_INV_PARAMETER;
+  Db *db = (Db *)hdb;
+  // The Store creates precisely one local nontransactional fixed-width DB.
+  // Reject accidental invocation on arbitrary handles before publishing.
+  if (db->config.flags != UPS_FORCE_RECORDS_INLINE || db->config.key_type != UPS_TYPE_UINT64 ||
+      db->config.key_size != 8 || db->config.record_size != 8 ||
+      db->env->config.flags != (UPS_IN_MEMORY | UPS_DISABLE_RECLAIM_INTERNAL))
+    return UPS_INV_PARAMETER;
+  if (!prepare_key(key) || !prepare_record(record))
+    return UPS_INV_PARAMETER;
+  DlockCall call = {db, key, record, insert, UPS_INTERNAL_ERROR};
+  *bridge_status = submit(gate, dlock_invoke, &call, metrics);
+  return *bridge_status == DLOCK_BRIDGE_OK ? call.result : UPS_INTERNAL_ERROR;
+}
+} // namespace
+
+extern "C" ups_status_t
+ups_dlock_private_find(ups_db_t *db, ups_key_t *key, ups_record_t *record,
+                       dlock_bridge *gate, ups_dlock_submit submit,
+                       dlock_request_metrics *metrics, int32_t *bridge_status)
+{
+  return dlock_dispatch(db, key, record, false, gate, submit, metrics, bridge_status);
+}
+
+extern "C" ups_status_t
+ups_dlock_private_insert(ups_db_t *db, ups_key_t *key, ups_record_t *record,
+                         dlock_bridge *gate, ups_dlock_submit submit,
+                         dlock_request_metrics *metrics, int32_t *bridge_status)
+{
+  return dlock_dispatch(db, key, record, true, gate, submit, metrics, bridge_status);
+}
+
+extern "C" void *ups_dlock_private_native_mutex(ups_db_t *hdb) {
+  Db *db = (Db *)hdb;
+  return db ? db->env->mutex.native_handle() : 0;
+}
+
+#ifdef DLOCK_BRIDGE_TEST_HOOKS
+extern "C" int32_t ups_dlock_private_test_throw(dlock_bridge *gate,
+                                                 ups_dlock_submit submit) {
+  DlockCall call = {0, 0, 0, false, UPS_INTERNAL_ERROR};
+  return submit(gate, dlock_invoke, &call, 0);
+}
+extern "C" ups_status_t ups_dlock_private_test_exception(dlock_bridge *gate,
+                                                           ups_dlock_submit submit) {
+  DlockCall call = {0, 0, 0, false, UPS_INTERNAL_ERROR, true};
+  return submit(gate, dlock_invoke, &call, 0) == DLOCK_BRIDGE_OK
+      ? call.result : UPS_INTERNAL_ERROR;
+}
+extern "C" void ups_dlock_private_test_pause(int enabled) {
+  if (enabled) dlock_test_entered.store(0, std::memory_order_release);
+  dlock_test_pause.store(enabled, std::memory_order_release);
+}
+extern "C" int ups_dlock_private_test_entered() {
+  return dlock_test_entered.load(std::memory_order_acquire);
+}
+#endif
